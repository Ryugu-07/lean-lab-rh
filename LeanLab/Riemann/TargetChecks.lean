        (deriv (logDeriv (deBruijnNewmanHeatXi t)) s +
          logDeriv (deBruijnNewmanHeatXi t) s ^ 2) :=
  deBruijnNewmanHeatXi_timeRatio_eq_logDeriv_evolution t s hs

